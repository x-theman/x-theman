# Copy to .env and fill in. Never commit .env.

# Deployer wallet private key (0x…). Use a dedicated wallet.
PRIVATE_KEY=

# RPC endpoints (Alchemy, Infura, or your own node)
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# For `npm run verify:*` on Etherscan
ETHERSCAN_API_KEY=

# --- Token ---
# Set TOKEN_ADDRESS to reuse an existing ERC-20 instead of deploying AirdropToken.
TOKEN_ADDRESS=
TOKEN_NAME=Meridian
TOKEN_SYMBOL=MRD
# Whole tokens (18 decimals). Must cover the airdrop total in data/claims.json.
TOKEN_SUPPLY=1000000000

# --- Airdrop ---
# ISO date when claiming closes. Defaults to claimDeadline in config.js.
CLAIM_DEADLINE=
